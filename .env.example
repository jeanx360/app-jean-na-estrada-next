NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI
NEXT_PUBLIC_APP_URL=https://jneapp.app

# Exclusiva do servidor. Nunca use NEXT_PUBLIC_ e nunca envie ao GitHub.
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_AQUI
# Alternativa legada aceita pelo código: SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=SUBSTITUA_AQUI
VAPID_PRIVATE_KEY=SUBSTITUA_AQUI
VAPID_SUBJECT=mailto:seu-email@dominio.com

# String aleatória com pelo menos 16 caracteres para proteger os crons da Vercel.
CRON_SECRET=SUBSTITUA_POR_UMA_STRING_FORTE

# Google Cloud OAuth 2.0 — aplicativo Web.
GOOGLE_OAUTH_CLIENT_ID=SUBSTITUA.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=SUBSTITUA_AQUI

# Gere uma única vez com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=SUBSTITUA_POR_UMA_CHAVE_BASE64_DE_32_BYTES

# ID público do canal Jean na Estrada. Impede conectar acidentalmente outro canal.
YOUTUBE_CHANNEL_ID=UCFwFlCooeFKHSLXxkRTA70g
