NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI
NEXT_PUBLIC_APP_URL=https://app-jean-na-estrada-next.vercel.app

# Exclusiva do servidor. Nunca use NEXT_PUBLIC_ e nunca envie ao GitHub.
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_AQUI
# Alternativa legada aceita pelo código: SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=SUBSTITUA_AQUI
VAPID_PRIVATE_KEY=SUBSTITUA_AQUI
VAPID_SUBJECT=mailto:seu-email@dominio.com

# String aleatória com pelo menos 16 caracteres para proteger o cron da Vercel.
CRON_SECRET=SUBSTITUA_POR_UMA_STRING_FORTE
